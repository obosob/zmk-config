#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
  chosen {
    zmk,kscan = &mock_kscan;
    zmk,physical-layout = &physical_layout0;
  };

  mock_kscan: mock_kscan_0 {
    compatible = "zmk,kscan-mock";
    columns = <0>;
    rows = <0>;
    events = <0>;
  };
  default_transform: keymap_transform_0 {
    compatible = "zmk,matrix-transform";
    columns = <10>;
    rows = <4>;
    map = <
      RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8)
      RC(0,0) RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(0,9)
      RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
      RC(3,3) RC(3,4) RC(3,5) RC(3,6)
    >;
  };

  physical_layout0: physical_layout_0 {
    compatible = "zmk,physical-layout";
    display-name = "Default";
    transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
	    = <&key_physical_attrs 100 100  200   50    1500   800   550>
            , <&key_physical_attrs 100 100  300    0    1500   800   550>
            , <&key_physical_attrs 100 100  400   50    1500   800   550>
            , <&key_physical_attrs 100 100  500   50    1500   800   550>

            , <&key_physical_attrs 100 100 1000   50  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1100   50  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1200    0  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1300   50  (-1500)  800   550>

            , <&key_physical_attrs 100 100    0  250    1500   800   550>
            , <&key_physical_attrs 100 100  100  225    1500   800   550>
            , <&key_physical_attrs 100 100  200  150    1500   800   550>
            , <&key_physical_attrs 100 100  300  100    1500   800   550>
            , <&key_physical_attrs 100 100  400  150    1500   800   550>
            , <&key_physical_attrs 100 100  500  150    1500   800   550>

            , <&key_physical_attrs 100 100 1000  150  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1100  150  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1200  100  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1300  150  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1400  225  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1500  250  (-1500)  800   550>

            , <&key_physical_attrs 100 100  100  325    1500   800   550>
            , <&key_physical_attrs 100 100  200  250    1500   800   550>
            , <&key_physical_attrs 100 100  300  200    1500   800   550>
            , <&key_physical_attrs 100 100  400  250    1500   800   550>
            , <&key_physical_attrs 100 100  500  250    1500   800   550>

            , <&key_physical_attrs 100 100 1000  250  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1100  250  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1200  200  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1300  250  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1400  325  (-1500)  800   550>

            , <&key_physical_attrs 100 100  500  350    1500   800   550>
            , <&key_physical_attrs 100 100  600  350    1500   800   550>

            , <&key_physical_attrs 100 100  900  350  (-1500)  800   550>
            , <&key_physical_attrs 100 100 1000  350  (-1500)  800   550>
            ;
    };
};
